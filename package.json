{
  "name": "fable",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet home for your notes, projects, and tasks. Your files, your AI, your data.",
  "license": "MIT",
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron-forge start",
    "build": "tsc --noEmit && vite build && tsx scripts/build-desktop.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "seed": "tsx scripts/seed.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "icons": "tsx scripts/icons.ts",
    "format": "prettier --write apps packages scripts tests docs *.ts *.json *.cjs .github README.md",
    "predev": "tsx scripts/build-workers.ts",
    "pretest": "tsx scripts/build-workers.ts",
    "smoke": "tsx scripts/smoke-desktop.ts",
    "smoke:sidebar": "tsx scripts/smoke-sidebar.ts"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@lezer/highlight": "1.2.5",
    "@parcel/watcher": "2.6.0",
    "@supabase/supabase-js": "2.118.0",
    "better-sqlite3": "13.0.3",
    "diff3": "0.0.4",
    "electron-squirrel-startup": "1.0.1",
    "framer-motion": "14.3.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/diff3": "0.0.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/libsodium-wrappers-sumo": "0.7.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
